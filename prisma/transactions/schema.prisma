generator client {
  provider = "prisma-client-js"
  output   = "../../src/generated/transactions"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL_TX")
}

model Product {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  price       Decimal  @db.Decimal(10, 2)
  stock       Int      @default(0)
  userId      Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@map("products")
}
